# Nukopijuokite šį failą į .env ir užpildykite savo raktais:
# cp .env.example .env

# Claude AI raktas (iš console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Google Sheets spreadsheet ID (iš URL: docs.google.com/spreadsheets/d/ČIA_ID/edit)
SPREADSHEET_ID=xxxxxxxxxxxxx

# Google Cloud service account credentials JSON (visas failo turinys vienoje eilutėje)
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"..."}
